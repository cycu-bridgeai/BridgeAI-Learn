{
  "name": "bridgeai-learn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "prebuild": "node scripts/pre-fetch-all.js",
    "predev": "node scripts/pre-fetch-all.js",
    "build": "node scripts/validate-cs.mjs && nuxt build",
    "dev": "node scripts/validate-cs.mjs && nuxt dev",
    "generate": "node scripts/validate-cs.mjs && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify:api": "node scripts/verify-api.mjs"
  },
  "dependencies": {
    "@nuxt/content": "^3.12.0",
    "better-sqlite3": "^12.8.0",
    "nuxt": "^4.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sqlite3"
    ]
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/typography": "^0.5.19",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.2",
    "vue-tsc": "^3.2.6",
    "yaml": "^2.8.3"
  }
}
